{
  "expo": {
    "name": "EUEvent Scanner",
    "slug": "euevent-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/euevent-512.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C0808",
        "foregroundImage": "./assets/euevent-192.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/euevent-192.png"
    },
    "scheme": "euevent-scanner",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "EUEvent Scanner uses the camera to validate student entry tickets.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
